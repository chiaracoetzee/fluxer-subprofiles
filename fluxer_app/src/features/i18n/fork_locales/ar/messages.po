#. Helper description for Last Used persona mode
msgid "Untagged messages send as the persona that spoke most recently. Whenever anyone uses a persona tag, they automatically become the active persona."
msgstr "تُرسَل الرسائل بدون علامة باسم الشخصية التي تحدثت مؤخرًا. كلما استخدم أحد علامة شخصية، تصبح تلك الشخصية نشطة تلقائيًا."

#. Helper description for Manual persona mode
msgid "Untagged messages send as your chosen persona. Typing another persona’s tags will only send that single message and won’t switch who is active."
msgstr "تُرسَل الرسائل بدون علامة باسم الشخصية التي اخترتها. كتابة علامات شخصية أخرى ستُرسل تلك الرسالة فقط ولن تغيّر الشخصية النشطة."

#. OAuth scope description shown on the consent screen for the personas.read scope.
msgid "View your personas"
msgstr "عرض شخصياتك"

msgid "Where the signal bar appears"
msgstr "أين يظهر شريط الإشارات"

#. Progress label for avatar downloads
msgid "avatars downloaded"
msgstr "صور أفاتار تم تنزيلها"

#. Placeholder for persona name
msgid "e.g. Alice"
msgstr "مثال: Alice"

#. Placeholder for persona pronouns
msgid "e.g. she/her"
msgstr "مثال: هي"

#. Placeholder text for natural language timestamp input.
msgid "e.g. tomorrow at 3pm, in 2 hours, now"
msgstr "مثال: غدًا في 3 مساءً، خلال ساعتين، الآن"

#. Progress label for prepared personas
msgid "personas prepared"
msgstr "شخصيات تم تجهيزها"

#. Progress label when saving personas
msgid "saving personas"
msgstr "شخصيات تم حفظها"

#. placeholder {0}: importResults.warnings.length
msgid "{0} notice(s) during import"
msgstr "{0} ملاحظة أثناء الاستيراد"

#. placeholder {0}: progress.current
#. placeholder {1}: progress.total
#. placeholder {2}: progress.label ?? 'items'
#. placeholder {3}: progress.percent
msgid "{0} of {1} {2} ({3}%)"
msgstr "{0} من {1} {2} ({3}%)"

#. Native desktop dialog headline shown when an update has finished downloading. {appName} is the desktop app name and {version} the new version number.
msgid "{appName} {version} is ready to install."
msgstr "{appName} الإصدار {version} جاهز للتثبيت."

#. Accessible label on a lit signal icon. {label} is the signal name such as Reading, {names} is a comma-separated list of the people who turned it on.
msgid "{label}: {names}"
msgstr "{label}: {names}"

#. Tooltip when sending as a latched persona
msgid "{name} ({mode}) - Click to switch persona"
msgstr "{name} ({mode}) - انقر لتبديل الشخصية"

msgid "— Today at 12:00 PM"
msgstr "— اليوم الساعة 12:00"
